{
  "name": "avo-pi-arc-agi3",
  "version": "0.1.0",
  "private": true,
  "description": "An ARC-AGI-3 agent harness inspired by public AVO material and built around the Pi agent loop.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test",
    "demo:offline": "node src/cli.mjs demo-offline --all",
    "demo:public": "node src/cli.mjs run-public --all",
    "provider:check": "node src/cli.mjs provider-check",
    "local:preflight": "node scripts/local-preflight.mjs",
    "mission-control:install": "node scripts/validate-mission-control.mjs --stop-after=install",
    "mission-control:test": "node scripts/validate-mission-control.mjs --stop-after=test",
    "mission-control:build": "node scripts/validate-mission-control.mjs --stop-after=build",
    "mission-control:validate": "node scripts/validate-mission-control.mjs --stop-after=build",
    "benchmark:local": "node scripts/run-real-public-locked.mjs",
    "repair:local": "node scripts/run-trajectory-repair-loop.mjs",
    "complete:local": "node scripts/run-local-complete-secure.mjs",
    "security:scan": "node scripts/secret-scan.mjs",
    "verify": "npm run test && npm run security:scan && npm run demo:offline",
    "publish:private": "./scripts/publish-private.sh"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2"
  },
  "license": "MIT"
}
