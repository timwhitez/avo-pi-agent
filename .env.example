# Copy to .env or export these in your shell. Never commit real values.
OPENAI_BASE_URL=https://your-responses-compatible-endpoint.example/v1
OPENAI_API_KEY=replace-me
OPENAI_MODEL=replace-me
OPENAI_REASONING_EFFORT=max
# Replace these example provider/model claims with the configured endpoint's
# documented values. Responses-compatible endpoints do not expose one portable
# capability-discovery protocol, so the runtime never infers them from a name.
OPENAI_CONTEXT_WINDOW=128000
OPENAI_MAX_OUTPUT_TOKENS=16384
OPENAI_INPUT_MODALITIES=text
OPENAI_REASONING_EFFORTS=minimal,low,medium,high,max
OPENAI_SUPPORTS_DEVELOPER_ROLE=1
# none is the safest setting for endpoints whose prefix-cache contract is unknown.
OPENAI_CACHE_RETENTION=none

# ARC authentication defaults to the official toolkit's automatic anonymous-key
# endpoint. Keep ARC_API_KEY explicitly empty so python-dotenv cannot load a
# placeholder. The server-issued key is held only in process memory and redacted
# from logs. Set AVO_ARC_AUTH_MODE=registered and provide ARC_API_KEY only when
# an account-bound scorecard is explicitly required.
AVO_ARC_AUTH_MODE=anonymous-auto
ARC_API_KEY=
AVO_MIN_PUBLIC_GAMES=25

# Runtime tuning
AVO_MAX_ACTIONS=1000
AVO_MAX_OUTER_TURNS=1000
AVO_STALL_WINDOW=8
AVO_MEMORY_SURFACE_LIMIT=4
AVO_MEMORY_DIR=.avo-memory

# Canonical benchmarks default to cold-start and ignore the generic directories
# above in favor of empty run-owned namespaces. A declared warm start requires
# both existing directories plus a stable snapshot name.
# AVO_BENCHMARK_STATE_MODE=warm-start
# AVO_BENCHMARK_STATE_SNAPSHOT=my-immutable-snapshot-v1

# Child subprocesses receive a fail-closed allowlisted environment. Proxy
# variables are excluded by default because proxy URLs may contain credentials.
# Enable only when the Provider/ARC network path genuinely requires the trusted
# parent proxy configuration.
AVO_CHILD_ALLOW_PROXY=0

# Per-game analysis workspace. The safe default is files-only: the model may
# persist bounded text/JSON/CSV/Python source files but cannot execute code.
# Set isolated-python only when Docker or Podman is installed and the image has
# already been pulled locally. There is deliberately no host-Python fallback.
AVO_WORKSPACE_DIR=.avo-workspaces
AVO_WORKSPACE_MODE=files-only
AVO_WORKSPACE_PYTHON_TIMEOUT_MS=10000
AVO_WORKSPACE_CONTAINER_RUNTIME=docker
AVO_WORKSPACE_CONTAINER_IMAGE=python:3.12-slim

# Operator risk acceptance only: allow an operator-owned plaintext HTTP
# OPENAI_BASE_URL for real-run attestation. Leave unset for HTTPS endpoints.
# AVO_PROVIDER_ALLOW_PLAINTEXT=1
