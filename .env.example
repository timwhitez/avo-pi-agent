# Copy to .env or export these in your shell. Never commit real values.
OPENAI_BASE_URL=https://your-responses-compatible-endpoint.example/v1
OPENAI_API_KEY=replace-me
OPENAI_MODEL=replace-me
OPENAI_REASONING_EFFORT=max

# Optional: official online ARC scorecards. Local public environments can be
# cached and replayed without this after the first successful download.
ARC_API_KEY=replace-me

# Runtime tuning
AVO_MAX_ACTIONS=1000
AVO_MAX_OUTER_TURNS=12
AVO_STALL_WINDOW=8
AVO_MEMORY_DIR=.avo-memory
