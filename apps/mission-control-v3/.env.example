# Server-only Mission Control access authentication.
# Generate a fresh value locally, for example: openssl rand -base64 32
AVO_MISSION_CONTROL_USER=avo
AVO_MISSION_CONTROL_ACCESS_TOKEN=replace-me-with-a-random-32-byte-value

# Resource limits. One active run is the safest default for a local ARC runtime.
AVO_MISSION_CONTROL_MAX_ACTIVE_RUNS=1
AVO_MISSION_CONTROL_MAX_ACTIVE_RUNS_PER_SUBJECT=1
AVO_MISSION_CONTROL_MAX_SESSIONS=256

# Parent repository location when it is not two directories above this app.
AVO_REPO_ROOT=/absolute/path/to/avo-pi-agent

# Fail closed by default. Set to 1 only for non-production UI development when
# no real Provider-backed CopilotKit assistant is required. Production rejects it.
AVO_MISSION_CONTROL_ALLOW_EMPTY_ADAPTER=0
